#!/bin/sh
# repo-maintenance-guard: begin
repo_guard_root=$(git rev-parse --show-toplevel) || exit 1
repo_guard_found=0
export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8
for repo_guard_python in python3 python "py -3"; do
    if $repo_guard_python -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
        repo_guard_found=1
        $repo_guard_python "$repo_guard_root/tools/repo_maintenance_guard.py" commit-msg "$@" || exit $?
        break
    fi
done
if [ "$repo_guard_found" != 1 ]; then
    printf '%s\n' '安全检查需要 Python 3.10+，请安装后重试。' >&2
    exit 1
fi
# repo-maintenance-guard: end
# 启动层：只负责找一个能用的 Python 3，判据在同目录的 .py 里。
#
# 找不到解释器时**放行并提示，不是拦下**——缺个 Python 不该让整个仓库提交不了。
# 钩子不能是 .bat：git 找的是无扩展名的同名文件，在 Windows 上也用自带的 sh 执行。
dir=$(dirname "$0")
for py in python3 python py; do
  if command -v "$py" >/dev/null 2>&1; then
    if "$py" -c 'import sys; sys.exit(0 if sys.version_info[0]==3 else 1)' 2>/dev/null; then
      exec "$py" "$dir/commit_msg.py" "$@"
    fi
  fi
done
echo "提示：找不到 Python 3，跳过提交信息检查（规则见 AGENTS.md §1）。" >&2
exit 0
